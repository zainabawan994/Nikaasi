# Copy to .env.docker (git-ignored) for docker compose. Use long random values.
POSTGRES_PASSWORD=
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=
GEMINI_API_KEY=
# Secure cookies need HTTPS (http://localhost also works in modern browsers)
COOKIE_SECURE=1
# Set to 1 only behind a reverse proxy you control
TRUST_PROXY=
# Extra origins allowed to POST, comma separated (same-origin is always allowed)
ALLOWED_ORIGINS=
