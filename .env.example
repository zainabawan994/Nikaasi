# Copy to .env (git-ignored) and fill in. Never commit real secrets.
APP_ENV=development
PORT=3000

# PostgreSQL. Use a dedicated, non-superuser role (see SECURITY.md).
DATABASE_URL=postgresql://nikaasi_app:CHANGE_ME@localhost:5432/nikaasi

# First admin, created on startup only when no users exist. Remove after first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Weather: live (real rain from Open-Meteo, real-time clock) or demo (scripted story only)
WEATHER_SOURCE=live
WEATHER_REFRESH_S=300
WEATHER_ALERT_MM=10,25,50

# Google AI Studio (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Security (production defaults are stricter: secure cookies, HSTS, no /docs)
# ALLOWED_HOSTS: your domain(s), comma separated (localhost is always allowed)
ALLOWED_HOSTS=
# Rate limits per IP per minute, and per signed-in user for staff actions
RATE_LIMIT_READ_PER_MIN=240
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_STATIC_PER_MIN=600
RATE_LIMIT_STAFF_PER_MIN=30
MAX_STREAMS_PER_IP=6
MAX_STREAMS=300
MAX_CONNECTIONS=300
COOKIE_SECURE=
TRUST_PROXY=
ALLOWED_ORIGINS=
